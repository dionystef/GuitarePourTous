{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guitar Lab",
  "version": "1.0.0",
  "identifier": "com.guitarlab.desktop",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "resources": [
      "resources/engine/**/*",
      "resources/bin/ffmpeg",
      "resources/bin/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Studio de répétition guitare",
    "longDescription": "Décortique un morceau : stems isolés, grille d'accords synchronisée, solo en MIDI/tablature. Wrapper desktop Tauri du webapp Guitar Lab."
  }
}
